{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "HTTPSERVER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "win-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HTTPSERVER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "msvc-x64",
      "displayName": "MSVC x64 (Visual Studio)",
      "inherits": "win-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "mingw-x64",
      "displayName": "MinGW-w64 x64 (g++ / Ninja)",
      "inherits": "win-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      },
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;C:/mingw64/bin;$penv{PATH}"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "base"
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC ASan+UBSan",
      "inherits": "base",
      "cacheVariables": {
        "HTTPSERVER_SANITIZER": "address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-x64-debug",
      "displayName": "MSVC x64 Debug",
      "configurePreset": "msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "msvc-x64-release",
      "displayName": "MSVC x64 Release",
      "configurePreset": "msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "mingw-x64-debug",
      "displayName": "MinGW x64 Debug",
      "configurePreset": "mingw-x64"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "configurePreset": "gcc-asan"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-x64-debug",
      "configurePreset": "msvc-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-x64-debug",
      "configurePreset": "mingw-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-asan",
      "configurePreset": "gcc-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
